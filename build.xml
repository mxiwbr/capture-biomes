<?xml version="1.0" ?>
<!DOCTYPE xml>

<!-- FOR LIVE-DEBUGGING PURPOSES - DO NOT USE THIS TO COMPILE THE PLUGIN -->

<project name="CaptureBiomes" default="Build">

    <property name="gradle.cache" value="${user.home}/.gradle/caches/modules-2/files-2.1"/>

    <target name="Build">

        <delete file="./server/plugins/${ant.project.name}.jar"/>

        <jar jarfile="./server/plugins/${ant.project.name}.jar">

            <fileset dir="./build/classes/java/main/" includes="**/*"/>
            <fileset dir="./build/resources/main/" includes="**/*"/>

            <!-- bStats -->
            <zipfileset
                    src="${gradle.cache}/org.bstats/bstats-bukkit/3.2.1/1986613bb223a49323b23b5292ee377fc7e68e0a/bstats-bukkit-3.2.1.jar"
                    excludes="META-INF/versions/**,module-info.class"/>

            <!-- bStats Base (dependency of bstats-bukkit) -->
            <zipfileset
                    src="${gradle.cache}/org.bstats/bstats-base/3.2.1/6ed683df7699e1ea46de260ab30879f0509a28/bstats-base-3.2.1.jar"
                    excludes="META-INF/versions/**,module-info.class"/>

            <!-- Apache Commons Text -->
            <zipfileset
                    src="${gradle.cache}/org.apache.commons/commons-text/1.10.0/3363381aef8cef2dbc1023b3e3a9433b08b64e01/commons-text-1.10.0.jar"
                    excludes="META-INF/versions/**,module-info.class"/>

            <!-- Gson -->
            <zipfileset
                    src="${gradle.cache}/com.google.code.gson/gson/2.10.1/b3add478d4382b78ea20b1671390a858002feb6c/gson-2.10.1.jar"
                    excludes="META-INF/versions/**,module-info.class"/>

        </jar>
    </target>

</project>